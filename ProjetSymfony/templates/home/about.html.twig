{% extends 'base.html.twig' %}

{% block title %}About - Kelly Adams{% endblock %}

{% block body %}
    <!-- Page Title -->
    <div class="page-title" data-aos="fade">
        <div class="container">
            <nav class="breadcrumbs">
                <ol>
                    <li><a href="{{ path('app_home') }}">Home</a></li>
                    <li class="current">About</li>
                </ol>
            </nav>
            <h1>About Me</h1>
        </div>
    </div><!-- End Page Title -->

    <!-- About Section -->
    <section id="about" class="about section">
        <div class="container" data-aos="fade-up" data-aos-delay="100">
            <div class="row gy-4 justify-content-center">
                <div class="col-lg-4">
                    <img src="{{ asset('img/profile-img.jpg') }}" class="img-fluid" alt="">
                </div>
                <div class="col-lg-8 content">
                    <h2>Professional Illustrator &amp; Graphic Designer</h2>
                    <p class="fst-italic py-3">
                        Je suis une illustratrice passionnée basée à San Francisco, spécialisée dans la création d'œuvres uniques et captivantes.
                    </p>
                    <div class="row">
                        <div class="col-lg-6">
                            <ul>
                                <li><i class="bi bi-chevron-right"></i> <strong>Birthday:</strong> <span>1 May 1995</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>Website:</strong> <span>www.example.com</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>Phone:</strong> <span>+123 456 7890</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>City:</strong> <span>San Francisco, USA</span></li>
                            </ul>
                        </div>
                        <div class="col-lg-6">
                            <ul>
                                <li><i class="bi bi-chevron-right"></i> <strong>Age:</strong> <span>29</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>Degree:</strong> <span>Master</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>Email:</strong> <span>kelly@example.com</span></li>
                                <li><i class="bi bi-chevron-right"></i> <strong>Freelance:</strong> <span>Available</span></li>
                            </ul>
                        </div>
                    </div>
                    <p class="py-3">
                        Mon travail se concentre sur la création d'illustrations qui racontent des histoires et évoquent des émotions.
                        Avec plus de 10 ans d'expérience, j'ai eu le plaisir de collaborer avec de nombreux clients
                        sur des projets variés, allant de livres pour enfants à des campagnes publicitaires.
                    </p>
                </div>
            </div>
        </div>
    </section><!-- /About Section -->

    <!-- Skills Section -->
    <section id="skills" class="skills section">
        <div class="container section-title" data-aos="fade-up">
            <h2>Skills</h2>
            <p>Mes compétences artistiques et techniques</p>
        </div>

        <div class="container" data-aos="fade-up" data-aos-delay="100">
            <div class="row skills-content skills-animation">
                <div class="col-lg-6">
                    <div class="progress">
                        <span class="skill"><span>Illustration</span> <i class="val">95%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="progress">
                        <span class="skill"><span>Digital Painting</span> <i class="val">90%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="progress">
                        <span class="skill"><span>Character Design</span> <i class="val">85%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="progress">
                        <span class="skill"><span>Adobe Photoshop</span> <i class="val">92%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="92" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="progress">
                        <span class="skill"><span>Adobe Illustrator</span> <i class="val">88%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="88" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="progress">
                        <span class="skill"><span>Procreate</span> <i class="val">93%</i></span>
                        <div class="progress-bar-wrap">
                            <div class="progress-bar" role="progressbar" aria-valuenow="93" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section><!-- /Skills Section -->
{% endblock %}