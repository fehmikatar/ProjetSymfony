{% extends 'front/base.html.twig' %}

{% block title %}Home - Artty{% endblock %}
{% block meta_description %}I'm a professional illustrator from San Francisco{% endblock %}
{% block meta_keywords %}illustrator, portfolio, designer{% endblock %}
{% block body_class %}index-page{% endblock %}

{% block body %}

    <!-- Hero Section -->
    <section id="hero" class="hero section">

        <img src="{{ asset('Frontend/assets/img/hero-bg.jpg') }}" alt="Hero Background" data-aos="fade-in">

        <div class="container text-center" data-aos="zoom-out" data-aos-delay="100">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <h2>Kelly Adams</h2>
                    <p>I'm a professional illustrator from San Francisco</p>
                    <a href="{{ path('app_front_about') }}" class="btn-get-started">About Me</a>
                </div>
            </div>
        </div>

    </section><!-- /Hero Section -->

{% endblock %}