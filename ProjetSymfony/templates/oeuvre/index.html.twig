{% extends 'base.html.twig' %}

{% block title %}Liste des œuvres{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="mb-4">Toutes les œuvres</h1>
        <div class="mb-3">
            <a href="{{ path('app_oeuvre_new') }}" class="btn btn-success">
                + Ajouter une œuvre
            </a>
        </div>

        <table class="table table-striped align-middle">
            <thead class="table-dark">
            <tr>
                <th>Image</th>
                <th>Titre</th>
                <th>Catégorie</th>
                <th>Prix (€)</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for oeuvre in oeuvres %}
                <tr>
                    <td>
                        {% if oeuvre.imageName %}
                            <img src="{{ asset('images/oeuvres/' ~ oeuvre.imageName) }}"
                                 alt="{{ oeuvre.titre }}"
                                 style="max-width:60px;">
                        {% else %}
                            <span class="text-muted">Aucune image</span>
                        {% endif %}
                    </td>
                    <td>{{ oeuvre.titre }}</td>
                    <td>{{ oeuvre.category.nom ?? 'Sans catégorie' }}</td>
                    <td>
                        {% if oeuvre.prix is not null %}
                            {{ oeuvre.prix|number_format(2) }}
                        {% endif %}
                    </td>
                    <td>
                        <span class="text-truncate d-block" style="max-width: 240px;">{{ oeuvre.description|u.truncate(70, '...') }}</span>
                    </td>
                    <td>
                        <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}" class="btn btn-outline-primary btn-sm">Voir</a>
                        <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-outline-warning btn-sm">Modifier</a>
                        {{ include('oeuvre/_delete_form.html.twig') }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-muted">Aucune œuvre enregistrée.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}